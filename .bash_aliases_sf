alias diff='diff --color=auto'
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias ls-git="find . -path ./.git -prune -o -type f -exec ls --color=auto -la '{}' \+"

# wslock.py: open offspace until the next login, or lock it again now
alias wsunlock="pkill -f '^python3 .*/wslock\.py$'"
alias wslock='setsid -f ~/bin/wslock.py'
